//@version=6
// Jev Signal (MON proxy)
// -----------------------------------------------------------------------------
// A reduced port of the DECISION LAYER of jev-trader, so the signal can be
// eyeballed on TradingView. It mirrors src/model.ts (MockModel) and the state
// built in src/trader.ts::buildState, as far as candle + volume data allows:
//
//   signal = returnsBps.last20 / 8  +  bookImbalance * 1.5  +  flow * 2
//   buyP   = 1 / (1 + exp(-signal))
//
// Mapping:
//   returnsBps.last1/5/20/100  ->  close-to-close bps on the chart timeframe
//   trades.cvdMon / volume     ->  flow   (signed-volume proxy, -1..1)
//   bookImbalance              ->  pressure (fast 10-bar signed-volume proxy)
//
// THIS IS NOT THE STRATEGY. TradingView cannot see Kuru's on-chain L2 book on
// Monad, cannot read its Trade logs, cannot place a post-only order, and has no
// notion of the 300 ms block. Book imbalance is the one input with no good
// proxy, so the signal here is weaker than the bot's. Use it only to judge
// whether the direction call leans the right way before paying for gas.
// -----------------------------------------------------------------------------

indicator("Jev Signal (MON proxy)", overlay=false, precision=3)

// ── Model inputs (defaults mirror src/model.ts MockModel) ────────────────────
momDiv = input.float(8.0, "momentum divisor (ret20 / x)", step=0.5, group="Model")
imbW   = input.float(1.5, "imbalance weight (pressure * x)", step=0.1, group="Model")
flowW  = input.float(2.0, "flow weight (cvd * x)", step=0.1, group="Model")
horizon = input.int(100, "flow horizon (bars)", minval=5, group="Model")

// ── Feature block (parallels buildState) ────────────────────────────────────
rng  = math.max(high - low, syminfo.mintick)
r1   = nz((close - close[1]) / close[1]) * 10000.0
r5   = nz((close - close[5]) / close[5]) * 10000.0
r20  = nz((close - close[20]) / close[20]) * 10000.0
r100 = nz((close - close[100]) / close[100]) * 10000.0

deltaVol = (close - open) / rng * volume        // signed volume, the CVD stand-in
flowWin  = math.sum(deltaVol, horizon)
volWin   = math.sum(volume, horizon)
flow     = volWin > 0 ? flowWin / volWin : 0.0  // -1..1, ~ cvdMon / (buy+sell)

pressure = math.sum(deltaVol, 10) / math.max(math.sum(volume, 10), 1)  // -1..1

signal = r20 / momDiv + pressure * imbW + flow * flowW
buyP   = 1.0 / (1.0 + math.exp(-signal))
sellP  = 1.0 - buyP

// ── Plots ───────────────────────────────────────────────────────────────────
plot(buyP * 100, "buy %", color=color.new(#26a69a, 0), linewidth=2)
plot(sellP * 100, "sell %", color=color.new(#ef5350, 0), linewidth=2)
hline(50, "coin flip", color=color.new(color.gray, 30), linestyle=hline.style_dashed)

fmt(x) => str.tostring(x, "#.##")

var table t = table.new(position.top_right, 2, 8, border_width=1, frame_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Jev Signal (proxy)", text_size=size.small)
    table.cell(t, 1, 0, timeframe.period, text_size=size.small)
    table.cell(t, 0, 1, "ret 1 / 5 bps", text_size=size.small)
    table.cell(t, 1, 1, fmt(r1) + " / " + fmt(r5), text_size=size.small)
    table.cell(t, 0, 2, "ret 20 / 100 bps", text_size=size.small)
    table.cell(t, 1, 2, fmt(r20) + " / " + fmt(r100), text_size=size.small)
    table.cell(t, 0, 3, "flow (-1..1)", text_size=size.small)
    table.cell(t, 1, 3, fmt(flow), text_size=size.small)
    table.cell(t, 0, 4, "pressure (-1..1)", text_size=size.small)
    table.cell(t, 1, 4, fmt(pressure), text_size=size.small)
    table.cell(t, 0, 5, "signal", text_size=size.small)
    table.cell(t, 1, 5, fmt(signal), text_size=size.small)
    table.cell(t, 0, 6, "buy %", text_size=size.small)
    table.cell(t, 1, 6, fmt(buyP * 100), text_size=size.small)
    table.cell(t, 0, 7, "side", text_size=size.small)
    table.cell(t, 1, 7, buyP >= 0.5 ? "buy" : "sell", text_size=size.small)

alertcondition(buyP >= 0.5, "Jev buy", "Jev signal: buy")
alertcondition(buyP < 0.5, "Jev sell", "Jev signal: sell")
